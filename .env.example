# Copy to your hosting provider's environment settings. Never commit real values.

# ── Required in production ────────────────────────────────────────────────
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=vote.kepler.ac.rw
DJANGO_CSRF_TRUSTED_ORIGINS=https://vote.kepler.ac.rw
SITE_URL=https://vote.kepler.ac.rw
DATABASE_URL=postgres://user:password@host:5432/kepler_voting

# ── First admin account (created automatically on deploy) ─────────────────
DJANGO_ADMIN_EMAIL=admin@kepler.ac.rw
DJANGO_ADMIN_PASSWORD=choose-a-strong-password

# ── Email (needed for sign-up verification + password reset) ──────────────
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_FROM_EMAIL=Kepler Voting <no-reply@kepler.ac.rw>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=no-reply@kepler.ac.rw
EMAIL_HOST_PASSWORD=app-password-here

# ── Uploaded photos ───────────────────────────────────────────────────────
DJANGO_SERVE_MEDIA=1
# Point at a persistent disk, or uploads vanish on redeploy:
DJANGO_MEDIA_ROOT=/var/data/media
